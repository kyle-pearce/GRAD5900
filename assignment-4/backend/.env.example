# Ollama model overrides (optional — defaults shown)
# CHAT_MODEL=llama3.2:3b
# EMBED_MODEL=nomic-embed-text

# Override context file directory (optional)
# CONTEXT_DIR=/path/to/your/context/files

# Gmail OAuth (optional — only needed if you want email draft saving to Gmail)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
