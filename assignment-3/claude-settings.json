{
  "mcpServers": {
    "gmail": {
      "command": "npx",
      "args": ["-y", "@shinzolabs/gmail-mcp"],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_REFRESH_TOKEN": "${GOOGLE_REFRESH_TOKEN}"
      }
    },
    "outlook": {
      "command": "npx",
      "args": ["-y", "ms-365-mcp-server"],
      "env": {
        "MS_CLIENT_ID": "${MS_CLIENT_ID}",
        "MS_CLIENT_SECRET": "${MS_CLIENT_SECRET}",
        "MS_REFRESH_TOKEN": "${MS_REFRESH_TOKEN}"
      }
    },
    "knowledge-base": {
      "command": "python",
      "args": [
        "../assignment-3/mcp-servers/knowledge-server/server.py"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      }
    },
    "google-calendar": {
      "command": "python",
      "args": [
        "../assignment-3/mcp-servers/calendar-server/server.py"
      ],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_CALENDAR_REFRESH_TOKEN": "${GOOGLE_CALENDAR_REFRESH_TOKEN}",
        "CALENDAR_TIMEZONE": "${CALENDAR_TIMEZONE}"
      }
    }
  }
}
