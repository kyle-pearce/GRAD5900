# Google OAuth2 credentials for Gmail MCP
# Obtain from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Microsoft OAuth2 credentials for Outlook MCP
# Obtain from Azure Portal: https://portal.azure.com/
MS_CLIENT_ID=your_ms_client_id_here
MS_CLIENT_SECRET=your_ms_client_secret_here
MS_REFRESH_TOKEN=your_ms_refresh_token_here
